     "url": "https://cdn.discordapp.com/attachments/1523117025952661597/1564306359573553282/rollenspiel.png?ex=6aea03d3&is=6ae8b253&hm=4f5af9ed71f418102557463dcdcce5a4ff0c96c401aa63f8d74d3793b5d67f90&",
     "proxy_url": "https://media.discordapp.net/attachments/1523117025952661597/1564306359573553282/rollenspiel.png?ex=6aea03d3&is=6ae8b253&hm=4f5af9ed71f418102557463dcdcce5a4ff0c96c401aa63f8d74d3793b5d67f90&",
